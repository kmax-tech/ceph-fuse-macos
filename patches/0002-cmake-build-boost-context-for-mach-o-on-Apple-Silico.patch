diff --git a/cmake/modules/BuildBoost.cmake b/cmake/modules/BuildBoost.cmake
index 732756b93..cccedbd7b 100644
--- a/cmake/modules/BuildBoost.cmake
+++ b/cmake/modules/BuildBoost.cmake
@@ -134,10 +134,17 @@ function(do_build_boost root_dir version)
   if(with_python_version)
     list(APPEND b2 python=${with_python_version})
   endif()
-  if(CMAKE_SYSTEM_PROCESSOR MATCHES "arm|ARM")
+  if(CMAKE_SYSTEM_PROCESSOR MATCHES "arm|ARM|aarch64")
     list(APPEND b2 abi=aapcs)
     list(APPEND b2 architecture=arm)
-    list(APPEND b2 binary-format=elf)
+    if(APPLE)
+      # Apple Silicon is aarch64 too, but the object format is Mach-O, not ELF.
+      # boost::context ships the matching *_arm64_aapcs_macho_gas.S sources.
+      list(APPEND b2 binary-format=mach-o)
+      list(APPEND b2 target-os=darwin)
+    else()
+      list(APPEND b2 binary-format=elf)
+    endif()
   endif()
   if(WITH_BOOST_VALGRIND)
     list(APPEND b2 valgrind=on)
