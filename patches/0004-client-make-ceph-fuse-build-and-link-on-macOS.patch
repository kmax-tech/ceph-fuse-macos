From 2f715b00a5f275c6a12096f20176fea5fed7af8b Mon Sep 17 00:00:00 2001
From: max <max@local>
Date: Mon, 31 Aug 2026 14:38:58 +0200
Subject: [PATCH 4/7] client: make ceph-fuse build and link on macOS

- request the vanilla libfuse3 API from macFUSE instead of its Darwin
  extensions, which swap struct stat for struct fuse_darwin_attr
- tie the xattr position parameter to that switch: it belongs to the Darwin
  extension API and is unused in the bodies anyway
- link libiconv for Boost::locale, which glibc provides but macOS does not
---
 src/client/CMakeLists.txt |  8 ++++++++
 src/client/fuse_ll.cc     |  4 ++--
 src/include/ceph_fuse.h   | 14 ++++++++++++++
 3 files changed, 24 insertions(+), 2 deletions(-)

diff --git a/src/client/CMakeLists.txt b/src/client/CMakeLists.txt
index 956bd0d8f..6470af7dd 100644
--- a/src/client/CMakeLists.txt
+++ b/src/client/CMakeLists.txt
@@ -16,3 +16,11 @@ target_link_libraries(client
   ICU::uc
   ICU::i18n
   )
+
+if(APPLE)
+  # Boost::locale calls iconv_open/iconv/iconv_close. glibc provides those, on
+  # macOS they live in a separate libiconv.
+  # find_package(Iconv) classifies iconv as built-in here and yields no link
+  # flag, so name the system library directly; it exports _iconv/_iconv_open.
+  target_link_libraries(client iconv)
+endif()
diff --git a/src/client/fuse_ll.cc b/src/client/fuse_ll.cc
index ce09db61f..e16d8e9a8 100644
--- a/src/client/fuse_ll.cc
+++ b/src/client/fuse_ll.cc
@@ -438,7 +438,7 @@ static void fuse_ll_setattr(fuse_req_t req, fuse_ino_t ino, struct stat *attr,
 static void fuse_ll_setxattr(fuse_req_t req, fuse_ino_t ino, const char *name,
 			     const char *value, size_t size, 
 			     int flags
-#if defined(__APPLE__)
+#if defined(__APPLE__) && FUSE_DARWIN_ENABLE_EXTENSIONS
 			     ,uint32_t pos
 #endif
   )
@@ -487,7 +487,7 @@ static void fuse_ll_listxattr(fuse_req_t req, fuse_ino_t ino, size_t size)
 
 static void fuse_ll_getxattr(fuse_req_t req, fuse_ino_t ino, const char *name,
 			     size_t size
-#if defined(__APPLE__)
+#if defined(__APPLE__) && FUSE_DARWIN_ENABLE_EXTENSIONS
 			     ,uint32_t position
 #endif
   )
diff --git a/src/include/ceph_fuse.h b/src/include/ceph_fuse.h
index cfa8097bb..9c6163c71 100644
--- a/src/include/ceph_fuse.h
+++ b/src/include/ceph_fuse.h
@@ -23,6 +23,20 @@
 #define FUSE_USE_VERSION	312
 #endif
 
+/*
+ * macFUSE's libfuse3 defaults to its Darwin extensions, which replace
+ * "struct stat" with "struct fuse_darwin_attr" in the low-level callbacks and
+ * reply functions. Ceph implements the vanilla libfuse3 API, so ask for it;
+ * macFUSE exports both ABIs side by side (fuse_reply_attr and
+ * fuse_reply_attr$DARWIN). This costs the Darwin-only attributes, which the
+ * Ceph client does not carry anyway.
+ */
+#ifdef __APPLE__
+#ifndef FUSE_DARWIN_ENABLE_EXTENSIONS
+#define FUSE_DARWIN_ENABLE_EXTENSIONS 0
+#endif
+#endif
+
 #include <fuse.h>
 #include "acconfig.h"
 
-- 
