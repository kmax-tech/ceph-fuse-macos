From 20f26493926a3cf943056f15f320861f4e089bee Mon Sep 17 00:00:00 2001
From: max <max@local>
Date: Mon, 31 Aug 2026 16:04:10 +0200
Subject: [PATCH 6/7] client: honour client_mount_uid/client_mount_gid per
 request

CephFS checks uid/gid like a local filesystem does, so a client whose local
uids are unrelated to the cluster's -- a Mac against an LDAP-managed cluster --
cannot write anywhere it does not own. The Samba gateway sidesteps this by
acting under a cluster identity server-side.

client_mount_uid/client_mount_gid already exist and are documented as 'uid to
mount as', but Client.cc only reads them once at init while fuse_ll.cc rebuilt
UserPerm from the FUSE context on every request, so they had no effect. Route
all 16 call sites through one helper that consults them.

Group resolution now follows the effective identity, and an unknown local uid
yields no supplementary groups instead of an error.
---
 src/client/fuse_ll.cc | 67 +++++++++++++++++++++++++++----------------
 1 file changed, 42 insertions(+), 25 deletions(-)

diff --git a/src/client/fuse_ll.cc b/src/client/fuse_ll.cc
index 5e990d25d..ed9a9a845 100644
--- a/src/client/fuse_ll.cc
+++ b/src/client/fuse_ll.cc
@@ -318,7 +318,7 @@ static int local_getgroups(uid_t uid, gid_t gid, gid_t **sgids)
   struct passwd pwd, *result = nullptr;
   char pwbuf[4096];
   if (getpwuid_r(uid, &pwd, pwbuf, sizeof(pwbuf), &result) != 0 || !result)
-    return -get_sys_errno(EINVAL);
+    return 0;   // uid unknown locally (e.g. pinned via client_mount_uid)
 
   // getgrouplist() reports the needed size on overflow, but Apple's version is
   // not reliable about it -- grow a bounded number of times instead of looping
@@ -353,6 +353,25 @@ static int local_getgroups(uid_t uid, gid_t gid, gid_t **sgids)
 }
 #endif
 
+/*
+ * The identity to act under. Normally the caller's, as handed over by FUSE.
+ * When client_mount_uid / client_mount_gid are set, act as that identity
+ * instead: CephFS checks uid/gid like a local filesystem, so a machine whose
+ * local uids are unrelated to the cluster's (a Mac against an LDAP-managed
+ * cluster) otherwise cannot write at all. This is what the Samba gateway does
+ * server-side; the options already exist and are documented as "uid to mount
+ * as", they were simply never consulted per request.
+ */
+static UserPerm fuse_ll_perms(CephFuse::Handle *cfuse, const struct fuse_ctx *ctx)
+{
+  const auto& conf = cfuse->client->cct->_conf;
+  int64_t mount_uid = conf.get_val<int64_t>("client_mount_uid");
+  int64_t mount_gid = conf.get_val<int64_t>("client_mount_gid");
+  uid_t uid = (mount_uid >= 0) ? static_cast<uid_t>(mount_uid) : ctx->uid;
+  gid_t gid = (mount_gid >= 0) ? static_cast<gid_t>(mount_gid) : ctx->gid;
+  return UserPerm(uid, gid);
+}
+
 static void get_fuse_groups(UserPerm& perms, fuse_req_t req)
 {
   CephFuse::Handle *cfuse = (CephFuse::Handle *)fuse_req_userdata(req);
@@ -361,10 +380,8 @@ static void get_fuse_groups(UserPerm& perms, fuse_req_t req)
     int count = getgroups(req, &gids);
 
 #if defined(__APPLE__)
-    if (count <= 0) {
-      const struct fuse_ctx *ctx = fuse_req_ctx(req);
-      count = local_getgroups(ctx->uid, ctx->gid, &gids);
-    }
+    if (count <= 0)
+      count = local_getgroups(perms.uid(), perms.gid(), &gids);
 #endif
 
     if (count > 0) {
@@ -391,7 +408,7 @@ static void fuse_ll_lookup(fuse_req_t req, fuse_ino_t parent, const char *name)
   struct fuse_entry_param fe;
   Inode *i2, *i1 = cfuse->iget(parent); // see below
   int r;
-  UserPerm perms(ctx->uid, ctx->gid);
+  UserPerm perms = fuse_ll_perms(cfuse, ctx);
   get_fuse_groups(perms, req);
 
   if (!i1)
@@ -440,7 +457,7 @@ static void fuse_ll_getattr(fuse_req_t req, fuse_ino_t ino,
   CephFuse::Handle *cfuse = fuse_ll_req_prepare(req);
