diff --git a/cmake/modules/FindFUSE.cmake b/cmake/modules/FindFUSE.cmake
index b55a2d36f..0611c46ca 100644
--- a/cmake/modules/FindFUSE.cmake
+++ b/cmake/modules/FindFUSE.cmake
@@ -77,5 +77,14 @@ if(FUSE_FOUND)
       IMPORTED_LINK_INTERFACE_LANGUAGES "C"
       IMPORTED_LOCATION "${FUSE_LIBRARIES}"
       VERSION "${FUSE_VERSION}")
+    if(APPLE)
+      # macFUSE ships both generations under /usr/local: the FUSE 2 headers in
+      # /usr/local/include{,/fuse} and the FUSE 3 headers in
+      # /usr/local/include/fuse3. Passed with -isystem, the FUSE 3 directory
+      # loses against clang's built-in /usr/local/include, so <fuse.h> resolves
+      # to the FUSE 2 compatibility header and the two generations collide.
+      # Plain -I puts it back in front.
+      set_target_properties(FUSE::FUSE PROPERTIES IMPORTED_NO_SYSTEM TRUE)
+    endif()
   endif()
 endif()
diff --git a/src/extblkdev/CMakeLists.txt b/src/extblkdev/CMakeLists.txt
index 27e7c23e4..e0d59d462 100644
--- a/src/extblkdev/CMakeLists.txt
+++ b/src/extblkdev/CMakeLists.txt
@@ -8,7 +8,11 @@ add_library(extblkdev STATIC ExtBlkDevPlugin.cc)
 
 if(NOT WIN32)
 find_package(cap)
-target_link_libraries(extblkdev cap)
+# libcap is Linux-only; without this guard the bare name "cap" reaches the
+# linker as -lcap even when find_package failed.
+if(cap_FOUND)
+  target_link_libraries(extblkdev cap)
+endif()
 endif()
 
 add_custom_target(extblkdev_plugins DEPENDS
diff --git a/src/osd/OSDMap.cc b/src/osd/OSDMap.cc
index f59543f95..e97ab9bb4 100644
--- a/src/osd/OSDMap.cc
+++ b/src/osd/OSDMap.cc
@@ -6512,14 +6512,14 @@ int OSDMap::calc_rbs_fair(CephContext *cct, OSDMap& tmp_osd_map, int64_t pool_id
     }
     if (prim_pgs_by_osd.count(osd)) {
       auto n_prims = prim_pgs_by_osd.at(osd).size();
-      max_prims_per_osd = std::max(max_prims_per_osd, n_prims);
+      max_prims_per_osd = std::max<uint64_t>(max_prims_per_osd, n_prims);
       if (osd_pa == 0.) {
         prim_on_zero_pa = true;
       }
     }
     if (acting_prims_by_osd.count(osd)) {
       auto n_aprims = acting_prims_by_osd.at(osd).size();
-      max_acting_prims_per_osd = std::max(max_acting_prims_per_osd, n_aprims);
+      max_acting_prims_per_osd = std::max<uint64_t>(max_acting_prims_per_osd, n_aprims);
       if (osd_pa != 0.) {
         max_osd_score = std::max(max_osd_score, float(n_aprims) / osd_pa);
       }
